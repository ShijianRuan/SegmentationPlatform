{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segmentation-platform/registry/schemas/review_task.schema.json",
  "title": "人工标注任务 Review Task",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "package_id",
    "case_id",
    "tool",
    "status",
    "targets",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "review_task.v1"},
    "review_id": {"type": "string"},
    "package_id": {"type": "string"},
    "case_id": {"type": "string"},
    "tool": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["ready", "in_progress", "needs_review", "completed", "blocked", "deferred"]
    },
    "assignee": {"type": ["string", "null"]},
    "package_path": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_id", "image_id", "organs", "status"],
        "properties": {
          "target_id": {"type": "string"},
          "image_id": {"type": "string"},
          "organs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": ["ready", "in_progress", "needs_review", "completed", "blocked", "deferred"]
          },
          "base_label_id": {"type": "string"},
          "base_label_sha256": {"$ref": "_defs.schema.json#/$defs/sha256_hash"},
          "completed_label_id": {"type": "string"},
          "last_submission_at": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "action"],
        "properties": {
          "at": {"type": "string"},
          "action": {"type": "string"},
          "actor": {"type": "string"},
          "target_ids": {"type": "array", "items": {"type": "string"}},
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
